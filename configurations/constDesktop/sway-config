exec fcitx5 -d

set $mod Mod4
set $datadir "/run/current-system/sw/share"
set $sysconfdir "/etc"
set $wallpaper $datadir/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png

output * {
    background $wallpaper fill
}

exec swayidle -w \
  timeout 300 'swaylock -f -c 000000' \
  timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep 'swaylock -f -c 000000'

bindsym $mod+Shift+e exit
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+d exec wmenu-run
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

set $move $mod+shift
bindsym $move+h move left
bindsym $move+j move down
bindsym $move+k move up
bindsym $move+l move right
bindsym $move+1 move container to workspace number 1
bindsym $move+2 move container to workspace number 2
bindsym $move+3 move container to workspace number 3
bindsym $move+4 move container to workspace number 4
bindsym $move+5 move container to workspace number 5
bindsym $move+6 move container to workspace number 6
bindsym $move+7 move container to workspace number 7
bindsym $move+8 move container to workspace number 8
bindsym $move+9 move container to workspace number 9
bindsym $move+0 move container to workspace number 10
bindsym $move+space floating toggle
bindsym $move+minus move scratchpad

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow  width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+minus scratchpad show

bindsym Print exec grim

bar {
    position top
    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

floating_modifier $mod normal

include $sysconfdir/sway/config.d/*
